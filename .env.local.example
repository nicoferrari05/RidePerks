# Copy to .env.local. Never commit real secrets.
# Set the same variables in the existing Vercel project.
SUPABASE_URL=https://your-project.supabase.co
# Public anon/publishable key, used only by the server auth client.
SUPABASE_ANON_KEY=your-anon-key
# Private server-only service_role key. Never use NEXT_PUBLIC_ for this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Existing admin login. ADMIN_SESSION_SECRET must have at least 32 characters.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
# Set production to https://rideperks.app; local development to its actual origin.
SITE_URL=http://localhost:3000
# Optional contact email shown in Help. Support requests work without this.
SUPPORT_EMAIL=

# Yappy payment-button credentials (not the separate Integraciones API keys).
YAPPY_ENABLED=false
YAPPY_MERCHANT_ID=
YAPPY_SECRET_KEY=
YAPPY_DOMAIN=https://www.rideperks.app

# Optional: Cloudflare Turnstile captcha on registration (both keys required).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: transactional email through Resend (receipts, verification, renewal
# reminders). Without both values the emails are simply skipped.
RESEND_API_KEY=
EMAIL_FROM=RidePerks <hola@rideperks.app>

# Required for the daily cron (/api/cron/daily). Vercel sends it automatically
# as "Authorization: Bearer <CRON_SECRET>". Use a long random string.
CRON_SECRET=
