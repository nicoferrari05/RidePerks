# Copia este archivo a ".env.local" (desarrollo) y configura las mismas
# variables como "Environment Variables" en Vercel para producción.
# .env.local nunca se sube a git (ver .gitignore).

# --- Supabase ---------------------------------------------------------
# Project Settings -> API en tu proyecto de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# OJO: esta es la "service_role key" (secreta). Se usa SOLO en el
# servidor (API routes de Next.js), nunca llega al navegador.
# No uses la "anon public key" para esto.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Panel de administración -------------------------------------------
# Contraseña compartida para entrar a /admin.
ADMIN_PASSWORD=cambia-esta-clave

# Cadena aleatoria larga usada para firmar la sesión del admin.
# Genera una con: openssl rand -hex 32
ADMIN_SESSION_SECRET=cambia-esta-cadena-aleatoria
