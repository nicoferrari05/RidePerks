{
  "expo": {
    "name": "RidePerks",
    "slug": "rideperks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rideperks",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "app.rideperks",
      "supportsTablet": false
    },
    "android": {
      "package": "app.rideperks",
      "adaptiveIcon": {
        "backgroundColor": "#0066cc",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0066cc",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "RidePerks usa tus fotos solo para que subas la captura de tu perfil de conductor.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RidePerks usa la cámara para escanear el código QR de los conductores.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
